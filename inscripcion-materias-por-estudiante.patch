+
+        const seccionResult = await pool.request()
+            .input('idSeccion', sql.Int, id)
+            .query(`
+                SELECT s.id_seccion, s.id_asignatura, s.id_periodo, s.estado
+                FROM Seccion s
+                WHERE s.id_seccion = @idSeccion
+            `);
