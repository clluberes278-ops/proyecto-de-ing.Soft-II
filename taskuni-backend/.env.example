# ============================================================================
# Plantilla de configuración del backend de taskUni.
# Copiar a .env y rellenar. El archivo .env NO se sube al repositorio.
# ============================================================================

# --- Base de datos (SQL Server con el esquema UniversidadDB ya creado) ------
DB_SERVER=localhost
DB_USER=sa
DB_PASSWORD=
DB_DATABASE=UniversidadDB
PORT=3000

# --- Correo saliente (alertas de RPT-04) -----------------------------------
# Si estas variables faltan, el backend arranca igual: las alertas se guardan
# en la bitácora con estado "Simulada" y no se envía ningún correo.
#
# Gmail: usar una CONTRASEÑA DE APLICACIÓN (Cuenta de Google > Seguridad >
# Verificación en 2 pasos > Contraseñas de aplicaciones). La contraseña normal
# de la cuenta no funciona.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu.cuenta@unphu.edu.do
SMTP_PASS=

# Opcional: "true" fuerza SSL. Si se omite, se deduce del puerto (465 = SSL,
# 587 y 25 = STARTTLS).
# SMTP_SECURE=false

# Opcional: remitente visible. Por defecto "taskUni UNPHU <SMTP_USER>".
# SMTP_FROM=taskUni UNPHU <no-reply@unphu.edu.do>
